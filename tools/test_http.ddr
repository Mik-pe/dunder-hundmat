capability process, network, filesystem

import .common as common
import std.array as array
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.net as net
import std.parse as parse
import std.process as process
import std.sha256 as sha256
import std.text as text
import sys

struct HttpResp {
    ok: bool,
    status: i32,
    content_length: i32,
    content_type: string,
    conn_hdr: string,
    body: []u8,
}

fn empty_resp() -> HttpResp {
    HttpResp { ok: false, status: 0, content_length: 0, content_type: "", conn_hdr: "", body: [] }
}

fn bytes_equal(a: &[]u8, b: &[]u8) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len {
        if a[i] != b[i] { return false }
    }
    true
}

fn ints_equal(a: &[]i32, b: &[]i32) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len {
        if a[i] != b[i] { return false }
    }
    true
}

fn parse_nonneg_ascii(buf: &[]u8, start: i32, end: i32) -> i32 {
    if start >= end { return -1 }
    mut v: i64 = 0
    for i in start..end {
        b := i32(buf[i])
        if b < 48 || b > 57 { return -1 }
        v = v * 10 + i64(b - 48)
        if v > 2147483647 { return -1 }
    }
    i32(v)
}

fn parse_one_http_from_buf(buf: &mut []u8, is_head: bool, out: &mut HttpResp) -> i32 {
    // Returns: 0 = need more bytes, 1 = parsed one complete response, -1 = protocol error
    hdr_end := bytes.find_double_crlf(&buf, 0, buf.len)
    if hdr_end < 0 { return 0 }

    first_crlf := bytes.find_crlf(&buf, 0, hdr_end)
    mut status_end := hdr_end
    if first_crlf >= 0 { status_end = first_crlf }
    sp1 := bytes.find_byte(&buf, 0, status_end, b' ')
    if sp1 < 0 || sp1 + 4 > status_end { return -1 }
    mut sp2 := bytes.find_byte(&buf, sp1 + 1, status_end, b' ')
    if sp2 < 0 { sp2 = status_end }
    st_code := parse_nonneg_ascii(&buf, sp1 + 1, sp2)
    if st_code < 100 { return -1 }

    mut clen := 0
    mut ctype := ""
    mut conn_val := ""
    if first_crlf >= 0 {
        mut line_start := first_crlf + 2
        while line_start < hdr_end {
            mut line_end := bytes.find_crlf(&buf, line_start, hdr_end)
            if line_end < 0 { line_end = hdr_end }
            colon := bytes.find_byte(&buf, line_start, line_end, b':')
            if colon < 0 { return -1 }
            mut val_start := colon + 1
            while val_start < line_end && (buf[val_start] == b' ' || buf[val_start] == b'\t') {
                val_start += 1
            }
            mut val_end := line_end
            while val_end > val_start && (buf[val_end - 1] == b' ' || buf[val_end - 1] == b'\t') {
                val_end -= 1
            }
            if bytes.equals_ascii_ci(&buf, line_start, colon, "content-length") {
                cl := parse_nonneg_ascii(&buf, val_start, val_end)
                if cl < 0 { return -1 }
                clen = cl
            } else if bytes.equals_ascii_ci(&buf, line_start, colon, "content-type") {
                dec := bytes.decode_range(&buf, val_start, val_end)
                if dec.ok { ctype = dec.value }
            } else if bytes.equals_ascii_ci(&buf, line_start, colon, "connection") {
                dec := bytes.decode_range(&buf, val_start, val_end)
                if dec.ok { conn_val = dec.value }
            }
            line_start = line_end + 2
        }
    }

    body_bytes := clen
    mut need_body := body_bytes
    if is_head { need_body = 0 }
    total_consumed := hdr_end + 4 + need_body
    if buf.len < total_consumed { return 0 }

    mut body: []u8 = []
    if need_body > 0 {
        bytes.extend_range(&mut body, &buf, hdr_end + 4, total_consumed)
    }
    bytes.consume_prefix(&mut buf, total_consumed)
    out = HttpResp {
        ok: true,
        status: st_code,
        content_length: clen,
        content_type: ctype,
        conn_hdr: conn_val,
        body: body,
    }
    1
}

fn read_response(stream: &net.TcpStream, rx_buf: &mut []u8, is_head: bool, timeout_ms: i64) -> HttpResp {
    mut resp := empty_resp()
    mut ps := net.poll_set()
    deadline := sys.now_ms() + timeout_ms
    while true {
        state := parse_one_http_from_buf(&mut rx_buf, is_head, &mut resp)
        if state == 1 { return resp }
        if state < 0 { return empty_resp() }
        rem := deadline - sys.now_ms()
        if rem <= 0 { return empty_resp() }
        net.poll_clear(&mut ps)
        net.poll_add(&mut ps, net.stream_fd(&stream), net.poll_in())
        mut wait_ms := 200
        if rem < i64(wait_ms) { wait_ms = i32(rem) }
        _ := net.poll(&mut ps, wait_ms)
        rd := net.read_append(&stream, &mut rx_buf, 65536)
        if !rd.ok {
            if rd.would_block { continue }
            return empty_resp()
        }
        if rd.eof {
            if parse_one_http_from_buf(&mut rx_buf, is_head, &mut resp) == 1 { return resp }
            return empty_resp()
        }
    }
    empty_resp()
}

fn send_raw(stream: &net.TcpStream, text_req: string) -> bool {
    mut raw: []u8 = []
    bytes.append_utf8(&mut raw, text_req)
    net.write_all(&stream, &raw).ok
}

fn launch_server(binary: string, work: string, doc_root: string, idle_ms: string, out_port: &mut i32) -> process.SpawnResult {
    mut cmd := process.command(binary.clone(), ["--host", "127.0.0.1", "--port", "0", "--dir", doc_root.clone(), "--idle-ms", idle_ms.clone()])
    process.set_cwd(&mut cmd, work.clone())
    sp := process.spawn(&cmd)
    if !sp.ok { return sp }
    mut child := sp.child
    line := process.read_stdout_line(&mut child, 5000)
    if !line.ok || !text.starts_with(line.value, "LISTENING ") {
        _ := process.kill(&mut child)
        _ := process.wait(&mut child, 2000)
        return process.SpawnResult { ok: false, child: child, error: 5 }
    }
    port_parsed := parse.integer(text.trim(line.value[10..line.value.len]))
    if !port_parsed.ok || port_parsed.value <= 0 || port_parsed.value > 65535 {
        _ := process.kill(&mut child)
        _ := process.wait(&mut child, 2000)
        return process.SpawnResult { ok: false, child: child, error: 22 }
    }
    out_port = i32(port_parsed.value)
    process.SpawnResult { ok: true, child: child, error: 0 }
}

fn check_concurrent_keepalive(port: i32, workers: i32, reqs_per_worker: i32, benchmark: bool) -> bool {
    mut streams := net.stream_set()
    defer { net.set_close_all(&mut streams) }

    mut req_even: []u8 = []
    bytes.append_utf8(&mut req_even, "GET /healthz HTTP/1.1\r\nHost: localhost\r\n\r\n")
    mut req_odd: []u8 = []
    bytes.append_utf8(&mut req_odd, "GET /sub/hello.txt HTTP/1.1\r\nHost: localhost\r\n\r\n")

    mut done_counts: []i32 = []
    mut tx_sent: []i32 = []
    mut rx_bufs_flat: []u8 = []
    stride := 4096
    rx_bufs_flat.reserve(workers * stride)
    for _ in 0..(workers * stride) { rx_bufs_flat.push(0) }
    mut rx_lens: []i32 = []
    mut req_started_ms: []i64 = []
    mut latencies_ms: []i64 = []
    if benchmark { latencies_ms.reserve(workers * reqs_per_worker) }

    for _ in 0..workers {
        c := net.connect(net.loopback(), port)
        if !c.ok { return common.fail("concurrent client connect failed") }
        mut s := c.stream
        _ := net.set_nodelay(&s, true)
        _ := net.set_nonblocking(&s, true)
        slot := net.set_insert(&mut streams, &mut s)
        assert(slot == done_counts.len)
        done_counts.push(0)
        tx_sent.push(0)
        rx_lens.push(0)
        if benchmark { req_started_ms.push(sys.now_ms()) }
    }

    t_start := sys.now_ms()
    deadline := t_start + 15000
    mut completed_workers := 0
    mut ps := net.poll_set()
    mut scratch: []u8 = []
    mut single_buf: []u8 = []

    while completed_workers < workers {
        now := sys.now_ms()
        if now > deadline { return common.fail("concurrent keep-alive requests timed out") }

        net.poll_clear(&mut ps)
        mut slot_map: []i32 = []
        for w in 0..workers {
            if done_counts[w] >= reqs_per_worker { continue }
            mut want := net.poll_in()
            mut target_len := req_even.len
            if done_counts[w] % 2 == 1 { target_len = req_odd.len }
            if tx_sent[w] < target_len {
                if benchmark && tx_sent[w] == 0 { req_started_ms[w] = now }
                mut wr := net.IoResult { ok: false, would_block: false, eof: false, count: 0, error: 0 }
                if done_counts[w] % 2 == 0 {
                    wr = net.set_write_range(&streams, w, &req_even, tx_sent[w], target_len - tx_sent[w])
                } else {
                    wr = net.set_write_range(&streams, w, &req_odd, tx_sent[w], target_len - tx_sent[w])
                }
                if wr.ok {
                    tx_sent[w] += i32(wr.count)
                } else if !wr.would_block {
                    return common.fail("concurrent client write failed")
                }
                if tx_sent[w] < target_len { want = want.bit_or(net.poll_out()) }
            }
            net.poll_add(&mut ps, net.set_fd(&streams, w), want)
            slot_map.push(w)
        }
        if slot_map.len == 0 { break }

        _ := net.poll(&mut ps, 50)
        mut now_after: i64 = 0
        if benchmark { now_after = sys.now_ms() }
        for pi in 0..slot_map.len {
            if ps.revents[pi] == 0 { continue }
            w := slot_map[pi]
            if ps.revents[pi].bit_and(net.poll_in().bit_or(net.poll_hup())) != 0 {
                scratch.clear()
                rd := net.set_read_append(&streams, w, &mut scratch, 4096 - rx_lens[w])
                if rd.ok && rd.count > 0 {
                    base := w * stride
                    for k in 0..scratch.len {
                        rx_bufs_flat[base + rx_lens[w] + k] = scratch[k]
                    }
                    rx_lens[w] += scratch.len

                    single_buf.clear()
                    bytes.extend_range(&mut single_buf, &rx_bufs_flat, base, base + rx_lens[w])
                    mut parsed := empty_resp()
                    st := parse_one_http_from_buf(&mut single_buf, false, &mut parsed)
                    if st < 0 { return common.fail("malformed response during concurrent load") }
                    if st == 1 {
                        if parsed.status != 200 { return common.fail("non-200 status during concurrent load") }
                        if done_counts[w] % 2 == 0 {
                            if !bytes.equals_text(&parsed.body, 0, parsed.body.len, "ok\n") {
                                return common.fail("unexpected /healthz body under load")
                            }
                        } else {
                            if parsed.body.len < 4 || !bytes.equals_text(&parsed.body, parsed.body.len - 4, parsed.body.len, "fil\n") {
                                return common.fail("unexpected /sub/hello.txt body under load")
                            }
                        }
                        rx_lens[w] = single_buf.len
                        for k in 0..single_buf.len {
                            rx_bufs_flat[base + k] = single_buf[k]
                        }
                        if benchmark { latencies_ms.push(now_after - req_started_ms[w]) }
                        done_counts[w] += 1
                        tx_sent[w] = 0
                        if done_counts[w] == reqs_per_worker {
                            completed_workers += 1
                        }
                    }
                } else if !rd.would_block {
                    return common.fail("unexpected EOF/error during concurrent keep-alive load")
                }
            }
        }
    }

    if benchmark {
        mut elapsed_ms := sys.now_ms() - t_start
        if elapsed_ms <= 0 { elapsed_ms = 1 }
        total_reqs := i64(workers * reqs_per_worker)
        rps := (total_reqs * 1000) / elapsed_ms
        array.sort(&mut latencies_ms)
        med_ms := latencies_ms[latencies_ms.len / 2]
        p95_ms := latencies_ms[(latencies_ms.len * 95) / 100]
        print("PASS concurrency & throughput: " + total_reqs.str() + " reqs across " + workers.str() + " clients in " + elapsed_ms.str() + "ms (" + rps.str() + " req/s, median=" + med_ms.str() + "ms, p95=" + p95_ms.str() + "ms)")
    } else {
        print("PASS concurrency: " + (workers * reqs_per_worker).str() + " responses across " + workers.str() + " clients")
    }
    true
}

pub fn run_suite_mode(compiler: string, root: string, benchmark: bool) -> bool {
    http_dir := root + "/http"
    tmp := fs.temp_dir("dunder-http-test-")
    if !tmp.ok { return common.fail("temp_dir failed") }
    work := tmp.value
    defer { _ := fs.remove_all(work) }

    binary := work + "/dunder-http"
    build_res := process.run_in(compiler, ["build", http_dir + "/src/main.ddr", "-o", binary.clone()], http_dir)
    if build_res.stdout.len > 0 { print(text.trim(process.stdout_text(&build_res))) }
    if !process.succeeded(&build_res) {
        return common.fail("failed building dunder-http: " + process.stderr_text(&build_res))
    }

    doc_root := work + "/www"
    if !fs.mkdir_all(doc_root + "/sub").ok { return common.fail("mkdir_all failed") }
    if !sys.write_text(doc_root + "/index.html", "<!doctype html><h1>Dunder HTTP</h1>\n").ok { return false }
    if !sys.write_text(doc_root + "/sub/hello.txt", "hej från statisk fil\n").ok { return false }
    if !sys.write_text(work + "/secret.txt", "TOP_SECRET_MUST_NEVER_ESCAPE").ok { return false }

    // 512 KiB pseudo-random binary payload + reference SHA-256
    mut large_bytes: []u8 = []
    large_bytes.reserve(524288)
    mut state_rng: u64 = 20261114
    for _ in 0..524288 {
        state_rng = state_rng.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407)
        large_bytes.push(u8(state_rng.shr(56).bit_and(255)))
    }
    large_sha := sha256.digest_bytes(&large_bytes)
    if !sys.write_u8(doc_root + "/large.bin", &large_bytes).ok { return common.fail("failed writing large.bin") }

    mut port := 0
    sp := launch_server(binary, work, doc_root, "5000", &mut port)
    if !sp.ok { return common.fail("dunder-http failed to launch and announce LISTENING") }
    mut server := sp.child
    defer {
        _ := process.terminate(&mut server)
        _ := process.wait(&mut server, 5000)
    }

    // 1. GET & HEAD /healthz + POST /echo binary + static files + 512 KiB large.bin + /stats via std.json
    {
        c1 := net.connect(net.loopback(), port)
        if !c1.ok { return common.fail("connect failed") }
        mut s := c1.stream
        defer { _ := net.close(&mut s) }
        _ := net.set_nodelay(&s, true)
        _ := net.set_nonblocking(&s, true)
        mut rx: []u8 = []

        if !send_raw(&s, "GET /healthz HTTP/1.1\r\nHost: localhost\r\n\r\n") { return false }
        r1 := read_response(&s, &mut rx, false, 5000)
        if !r1.ok || r1.status != 200 || !bytes.equals_text(&r1.body, 0, r1.body.len, "ok\n") {
            return common.fail("GET /healthz failed")
        }

        if !send_raw(&s, "HEAD /healthz HTTP/1.1\r\nHost: localhost\r\n\r\n") { return false }
        r2 := read_response(&s, &mut rx, true, 5000)
        if !r2.ok || r2.status != 200 || r2.content_length != 3 || r2.body.len != 0 {
            return common.fail("HEAD /healthz failed")
        }

        mut echo_payload: []u8 = []
        for b in 0..256 { echo_payload.push(u8(b)) }
        bytes.append_utf8(&mut echo_payload, "\r\n\r\nPOST /fake HTTP/1.1\r\n\r\n")
        mut post_req: []u8 = []
        bytes.append_utf8(&mut post_req, "POST /echo HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/x-test\r\nContent-Length: " + echo_payload.len.str() + "\r\n\r\n")
        bytes.extend(&mut post_req, &echo_payload)
        if !net.write_all(&s, &post_req).ok { return false }
        r3 := read_response(&s, &mut rx, false, 5000)
        if !r3.ok || r3.status != 200 || r3.content_type != "application/x-test" || !bytes_equal(&r3.body, &echo_payload) {
            return common.fail("POST /echo binary round-trip failed")
        }

        if !send_raw(&s, "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n") { return false }
        r4 := read_response(&s, &mut rx, false, 5000)
        if !r4.ok || r4.status != 200 || text.find(r4.content_type, "text/html") < 0 || text.find(bytes.decode(&r4.body).value, "Dunder HTTP") < 0 {
            return common.fail("GET / index.html failed")
        }

        if !send_raw(&s, "GET /sub/hello.txt HTTP/1.1\r\nHost: localhost\r\n\r\n") { return false }
        r5 := read_response(&s, &mut rx, false, 5000)
        if !r5.ok || r5.status != 200 || bytes.decode(&r5.body).value != "hej från statisk fil\n" {
            return common.fail("GET /sub/hello.txt failed")
        }

        if !send_raw(&s, "GET /large.bin HTTP/1.1\r\nHost: localhost\r\n\r\n") { return false }
        r6 := read_response(&s, &mut rx, false, 5000)
        if !r6.ok || r6.status != 200 { return common.fail("GET /large.bin failed") }
        got_sha := sha256.digest_bytes(&r6.body)
        if !bytes_equal(&got_sha, &large_sha) {
            return common.fail("GET /large.bin SHA-256 mismatch")
        }

        if !send_raw(&s, "GET /stats HTTP/1.1\r\nHost: localhost\r\n\r\n") { return false }
        r7 := read_response(&s, &mut rx, false, 5000)
        if !r7.ok || r7.status != 200 { return common.fail("GET /stats failed") }
        doc := json.parse_bytes(&r7.body)
        if !doc.ok { return common.fail("GET /stats invalid JSON: " + doc.error) }
        reqs_f := json.get_i64(&doc, doc.root, "requests")
        conns_f := json.get_i64(&doc, doc.root, "active_connections")
        if !reqs_f.ok || reqs_f.value < 7 || !conns_f.ok || conns_f.value < 1 {
            return common.fail("GET /stats unexpected counters")
        }
    }

    // 2. Raw-socket path traversal confinement
    bad_paths: []string = ["/../secret.txt", "/sub/../../secret.txt", "//etc/passwd", "/sub/"]
    for bp in bad_paths {
        c := net.connect(net.loopback(), port)
        if !c.ok { return common.fail("connect failed for traversal check") }
        mut s := c.stream
        defer { _ := net.close(&mut s) }
        _ := net.set_nonblocking(&s, true)
        mut rx: []u8 = []
        if !send_raw(&s, "GET " + bp + " HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n") { return false }
        resp := read_response(&s, &mut rx, false, 5000)
        if !resp.ok || (resp.status != 400 && resp.status != 404) {
            return common.fail("traversal path was not rejected: " + bp)
        }
        if text.find(bytes.decode(&resp.body).value, "TOP_SECRET") >= 0 {
            return common.fail("SECRET LEAKED on traversal probe!")
        }
    }

    // 3. Single-connection keep-alive (10 sequential) + 4x HTTP pipelining + Connection: close
    {
        c := net.connect(net.loopback(), port)
        if !c.ok { return common.fail("connect failed for pipelining") }
        mut s := c.stream
        defer { _ := net.close(&mut s) }
        _ := net.set_nodelay(&s, true)
        _ := net.set_nonblocking(&s, true)
        mut rx: []u8 = []
        for _ in 0..10 {
            if !send_raw(&s, "GET /healthz HTTP/1.1\r\nHost: localhost\r\n\r\n") { return false }
            r := read_response(&s, &mut rx, false, 5000)
            if !r.ok || r.status != 200 || !bytes.equals_text(&r.body, 0, r.body.len, "ok\n") {
                return common.fail("keep-alive sequential request failed")
            }
        }
        pipelined := "GET /healthz HTTP/1.1\r\nHost: localhost\r\n\r\n" +
            "POST /echo HTTP/1.1\r\nHost: localhost\r\nContent-Length: 4\r\n\r\nabcd" +
            "GET /sub/hello.txt HTTP/1.1\r\nHost: localhost\r\n\r\n" +
            "GET /healthz HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
        if !send_raw(&s, pipelined) { return false }
        p1 := read_response(&s, &mut rx, false, 5000)
        p2 := read_response(&s, &mut rx, false, 5000)
        p3 := read_response(&s, &mut rx, false, 5000)
        p4 := read_response(&s, &mut rx, false, 5000)
        if !p1.ok || p1.status != 200 || !bytes.equals_text(&p1.body, 0, p1.body.len, "ok\n") { return common.fail("pipeline 1 failed") }
        if !p2.ok || p2.status != 200 || !bytes.equals_text(&p2.body, 0, p2.body.len, "abcd") { return common.fail("pipeline 2 failed") }
        if !p3.ok || p3.status != 200 || bytes.decode(&p3.body).value != "hej från statisk fil\n" { return common.fail("pipeline 3 failed") }
        if !p4.ok || p4.status != 200 || p4.conn_hdr != "close" || rx.len != 0 { return common.fail("pipeline 4 failed") }

        mut ps := net.poll_set()
        net.poll_add(&mut ps, net.stream_fd(&s), net.poll_in())
        _ := net.poll(&mut ps, 1000)
        eof_rd := net.read_append(&s, &mut rx, 16)
        if !eof_rd.ok || !eof_rd.eof {
            return common.fail("expected clean EOF after Connection: close")
        }
    }

    // 4. Fragmented delivery across separate poll ticks + error status codes
    {
        c := net.connect(net.loopback(), port)
        if !c.ok { return common.fail("connect failed for fragmented request") }
        mut s := c.stream
        defer { _ := net.close(&mut s) }
        _ := net.set_nodelay(&s, true)
        _ := net.set_nonblocking(&s, true)
        mut rx: []u8 = []
        if !send_raw(&s, "POST /ech") { return false }
        sys.sleep_ms(10)
        if !send_raw(&s, "o HTTP/1.1\r\nContent-Length: 5\r\n\r\nhe") { return false }
        sys.sleep_ms(10)
        if !send_raw(&s, "llo") { return false }
        rf := read_response(&s, &mut rx, false, 5000)
        if !rf.ok || rf.status != 200 || !bytes.equals_text(&rf.body, 0, rf.body.len, "hello") {
            return common.fail("fragmented request failed")
        }
    }

    err_reqs: []string = [
        "BAD\r\n\r\n",
        "FOOBAR / HTTP/1.1\r\n\r\n",
        "POST /echo HTTP/1.1\r\nContent-Length: 100000\r\n\r\n",
        "POST /echo HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n",
    ]
    err_codes: []i32 = [400, 501, 413, 501]
    for i in 0..err_reqs.len {
        c := net.connect(net.loopback(), port)
        if !c.ok { return common.fail("connect failed for error status check") }
        mut s := c.stream
        defer { _ := net.close(&mut s) }
        _ := net.set_nonblocking(&s, true)
        mut rx: []u8 = []
        if !send_raw(&s, err_reqs[i]) { return false }
        re := read_response(&s, &mut rx, false, 5000)
        if !re.ok || re.status != err_codes[i] {
            return common.fail("expected HTTP error " + err_codes[i].str() + ", got " + re.status.str())
        }
    }

    // 5. Default: bounded concurrency correctness. Measurements require --benchmark.
    if benchmark {
        if !check_concurrent_keepalive(port, 16, 100, true) { return false }
    } else {
        if !check_concurrent_keepalive(port, 8, 16, false) { return false }
    }

    _ := process.terminate(&mut server)
    _ := process.wait(&mut server, 5000)

    // 6. Idle timeout disconnect test
    mut idle_port := 0
    sp_idle := launch_server(binary, work, doc_root, "250", &mut idle_port)
    if !sp_idle.ok { return common.fail("failed launching idle-timeout server") }
    mut idle_srv := sp_idle.child
    defer {
        _ := process.terminate(&mut idle_srv)
        _ := process.wait(&mut idle_srv, 5000)
    }
    {
        c := net.connect(net.loopback(), idle_port)
        if !c.ok { return common.fail("connect failed for idle timeout check") }
        mut s := c.stream
        defer { _ := net.close(&mut s) }
        _ := net.set_nonblocking(&s, true)
        mut ps := net.poll_set()
        net.poll_add(&mut ps, net.stream_fd(&s), net.poll_in())
        _ := net.poll(&mut ps, 2000)
        mut rx: []u8 = []
        rd := net.read_append(&s, &mut rx, 16)
        if !rd.ok || !rd.eof || rx.len != 0 {
            return common.fail("idle connection was not closed by server within timeout")
        }
    }

    print("PASS dunder-http: HTTP/1.1 methods, static SHA-256, traversal confinement, keep-alive, pipelining, errors, concurrency, and idle timeout")
    true
}

pub fn run_suite(compiler: string, root: string) -> bool {
    run_suite_mode(compiler, root, false)
}

fn main() -> i32 {
    cli := common.parse_http_cli()
    if !cli.ok { _ := sys.eprint(cli.error); return 2 }
    if !run_suite_mode(cli.compiler, cli.root, cli.benchmark) { return 1 }
    0
}
