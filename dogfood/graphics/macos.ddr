capability unsafe
import .macos.appkit as appkit
import .macos.objc as objc
import .macos.renderer as metal
import .macos.texture
import std.dl as dl

// Native macOS window + Metal triangle-list presentation.
// Window is a validated resource ID. Copies refer to the same native window.
pub struct Window { id: i64 }
pub struct OpenResult { ok: bool, window: Window, error: string }
pub struct Frame {
    closed: bool,
    width: i32,
    height: i32,
    pixel_width: i32,
    pixel_height: i32,
    scale: f64,
    time: f64,
    pointer_x: f64,
    pointer_y: f64,
    pointer_down: bool,
    key: i32,
    resized: bool,
}
pub struct DrawResult { ok: bool, error: string, frames: i64 }
pub struct CoverageAtlas { width: i32, height: i32, pixels: []u8 }
pub struct PixelResult { ok: bool, error: string, width: i32, height: i32, bgra: []u8 }

fn open_error(move message: string) -> OpenResult { OpenResult { ok: false, window: Window {id: 0}, error: message } }

unsafe fn open_window(s: &mut metal.State, title: string, width: i32, height: i32) -> OpenResult {
    if width < 1 || width > 16384 || height < 1 || height > 16384 {
        return open_error("Window dimensions must be between 1 and 16384 points")
    }
    if s.active != 0 { return open_error("A native macOS window is already open") }
    if !appkit.initialize(&mut s) { return open_error("Native macOS graphics are unavailable") }
    pool := objc.pool()
    ready := metal.setup(&mut s) && appkit.configure(&mut s, title, width, height)
    if !ready { appkit.destroy(&mut s) }
    objc.drain(pool)
    if !ready { return open_error("Could not create the native macOS window or Metal device") }
    OpenResult {ok: true, window: Window {id: s.generation}, error: ""}
}
pub fn open(title: string, width: i32, height: i32) -> OpenResult {
    unsafe { return open_window(ref_at(metal.state()), title, width, height) }
}

fn matches_window(s: &metal.State, window: Window) -> bool { s.active != 0 && window.id == s.generation }

unsafe fn poll_window(s: &mut metal.State, window: Window) -> Frame {
    if !matches_window(&s, window) {
        return Frame {closed:true, width:0, height:0, pixel_width:0, pixel_height:0, scale:0.0, time:0.0,
                      pointer_x:0.0, pointer_y:0.0, pointer_down:false, key:-1, resized:false}
    }
    appkit.poll(&mut s)
    frame := Frame {closed:s.closed != 0, width:s.width, height:s.height, pixel_width:s.pixelWidth,
                   pixel_height:s.pixelHeight, scale:s.scale, time:s.now() - s.start,
                   pointer_x:s.x, pointer_y:s.y, pointer_down:s.down != 0, key:s.key, resized:s.resized != 0}
    s.resized = 0
    frame
}
pub fn poll(window: Window) -> Frame {
    unsafe { return poll_window(ref_at(metal.state()), window) }
}

pub fn fits_texture(width: i32, height: i32) -> bool {
    width > 0 && height > 0 && width <= 16384 && height <= 16384 && width * height <= 16777216
}
fn valid_atlas(atlas: &CoverageAtlas) -> bool {
    fits_texture(atlas.width, atlas.height) && atlas.pixels.len == atlas.width * atlas.height
}
fn valid_triangles(vertices: &[]f32, stride: i32) -> bool {
    vertices.len <= 100000 * stride && vertices.len % (3 * stride) == 0
}

unsafe fn set_atlas(s: &mut metal.State, window: Window, atlas: &CoverageAtlas) -> DrawResult {
    if !matches_window(&s, window) { return DrawResult {ok:false, frames:0, error:"invalid or expired window handle"} }
    if s.closed != 0 { return DrawResult {ok:false, frames:s.frames, error:"window is closed"} }
    if !valid_atlas(&atlas) { return DrawResult {ok:false, frames:s.frames, error:"atlas dimensions or coverage byte count are invalid"} }
    pool := objc.pool()
    defer { objc.drain(pool) }
    next := texture.upload_coverage(s.device, atlas.width, atlas.height, &atlas.pixels)
    if next == ptr(0) { return DrawResult {ok:false, frames:s.frames, error:"Metal atlas allocation failed"} }
    objc.release(s.atlasTexture)
    s.atlasTexture = next
    DrawResult {ok:true, frames:s.frames, error:""}
}

pub fn upload_atlas(window: Window, atlas: &CoverageAtlas) -> DrawResult {
    unsafe { return set_atlas(ref_at(metal.state()), window, &atlas) }
}

unsafe fn draw_window(s: &mut metal.State, window: Window, vertices: &[]f32, text: &[]f32,
    red: f64, green: f64, blue: f64) -> DrawResult {
    if !matches_window(&s, window) { return DrawResult {ok:false, frames:0, error:"invalid or expired window handle"} }
    if s.closed != 0 { return DrawResult {ok:false, frames:s.frames, error:"window is closed"} }
    if !valid_triangles(&vertices, 8) {
        return DrawResult {ok:false, frames:s.frames, error:"vertices must be a triangle list of eight f32 values per vertex (max 100000 vertices)"}
    }
    if !valid_triangles(&text, 12) {
        return DrawResult {ok:false, frames:s.frames, error:"text vertices must be a triangle list of twelve f32 values per vertex (max 100000 vertices)"}
    }
    if text.len != 0 && s.atlasTexture == ptr(0) {
        return DrawResult {ok:false, frames:s.frames, error:"upload a coverage atlas before drawing text"}
    }
    pool := objc.pool()
    defer { objc.drain(pool) }
    if !metal.upload(&mut s, &vertices, &text, red, green, blue) {
        return DrawResult {ok:false, frames:s.frames, error:"Metal vertex buffer allocation failed"}
    }
    rendered := metal.render(&mut s)
    if !rendered { return DrawResult {ok:false, frames:s.frames, error:"Metal command buffer failed"} }
    DrawResult {ok:true, frames:s.frames, error:""}
}
pub fn draw(window: Window, vertices: &[]f32, red: f64, green: f64, blue: f64) -> DrawResult {
    text: []f32 = []
    unsafe { return draw_window(ref_at(metal.state()), window, &vertices, &text, red, green, blue) }
}
pub fn draw_atlas(window: Window, vertices: &[]f32, text: &[]f32, red: f64, green: f64, blue: f64) -> DrawResult {
    unsafe { return draw_window(ref_at(metal.state()), window, &vertices, &text, red, green, blue) }
}
unsafe fn close_window(s: &mut metal.State, window: Window) {
    if matches_window(&s, window) {
        pool := objc.pool()
        appkit.destroy(&mut s)
        objc.drain(pool)
    }
}
pub fn close(window: Window) { unsafe { close_window(ref_at(metal.state()), window) } }

fn pixel_error(move message: string) -> PixelResult {
    PixelResult {ok:false, width:0, height:0, bgra:[], error:message}
}

unsafe fn offscreen(width: i32, height: i32, vertices: &[]f32, text: &[]f32, atlas: &CoverageAtlas,
    red: f64, green: f64, blue: f64) -> PixelResult {
    if !fits_texture(width, height) { return pixel_error("offscreen dimensions are invalid") }
    if !valid_triangles(&vertices, 8) || !valid_triangles(&text, 12) { return pixel_error("invalid triangle list size") }
    library := dl.open(cstr("/System/Library/Frameworks/Metal.framework/Metal"), 2)
    if library == ptr(0) { return pixel_error("Metal framework is unavailable") }
    defer { _ := dl.close(library) }
    create := dl.symbol(library, cstr("MTLCreateSystemDefaultDevice"))
    if create == ptr(0) { return pixel_error("Metal device entry point is unavailable") }
    pool := objc.pool()
    defer { objc.drain(pool) }
    mut s: metal.State = zeroed()
    defer { metal.release(&mut s) }
    s.createDevice = ffi_fn(create)
    if !metal.setup(&mut s) { return pixel_error("could not create an offscreen Metal renderer") }
    if text.len != 0 {
        s.atlasTexture = texture.upload_coverage(s.device, atlas.width, atlas.height, &atlas.pixels)
        if s.atlasTexture == ptr(0) { return pixel_error("Metal atlas allocation failed") }
    }
    target := texture.color_target(s.device, width, height)
    if target == ptr(0) { return pixel_error("Metal render target allocation failed") }
    defer { objc.release(target) }
    if !metal.upload(&mut s, &vertices, &text, red, green, blue) { return pixel_error("Metal vertex buffer allocation failed") }
    if !metal.render_target(&s, target, ptr(0)) { return pixel_error("Metal offscreen rendering failed") }
    PixelResult {ok:true, width:width, height:height, error:"", bgra:texture.read_color(target, width, height)}
}

pub fn read_pixels(width: i32, height: i32, vertices: &[]f32, red: f64, green: f64, blue: f64) -> PixelResult {
    atlas := CoverageAtlas {width:0, height:0, pixels:[]}
    text: []f32 = []
    unsafe { return offscreen(width, height, &vertices, &text, &atlas, red, green, blue) }
}

pub fn read_atlas_pixels(width: i32, height: i32, vertices: &[]f32, text: &[]f32, atlas: &CoverageAtlas,
    red: f64, green: f64, blue: f64) -> PixelResult {
    if !valid_atlas(&atlas) { return pixel_error("atlas dimensions or coverage byte count are invalid") }
    unsafe { return offscreen(width, height, &vertices, &text, &atlas, red, green, blue) }
}

// Geometry is ordinary Dunder. Positions are Metal clip coordinates: +Y up.
// Each vertex is [x, y, 0, 1, red, green, blue, alpha]. Colors use straight alpha.
pub struct Point { x: f32, y: f32 }
pub struct Color { red: f32, green: f32, blue: f32, alpha: f32 }
pub struct UVRect { left: f32, top: f32, right: f32, bottom: f32 }

pub fn rgb(red: f32, green: f32, blue: f32) -> Color {
    Color { red: red, green: green, blue: blue, alpha: 1.0 }
}
pub fn rgba(red: f32, green: f32, blue: f32, alpha: f32) -> Color {
    Color { red: red, green: green, blue: blue, alpha: alpha }
}
pub fn vertex(vertices: &mut []f32, point: Point, color: Color) {
    vertices.push(point.x)
    vertices.push(point.y)
    vertices.push(0.0)
    vertices.push(1.0)
    vertices.push(color.red)
    vertices.push(color.green)
    vertices.push(color.blue)
    vertices.push(color.alpha)
}
pub fn triangle(vertices: &mut []f32, a: Point, b: Point, c: Point, color: Color) {
    vertex(&mut vertices, a, color)
    vertex(&mut vertices, b, color)
    vertex(&mut vertices, c, color)
}
pub fn gradient_triangle(vertices: &mut []f32, a: Point, b: Point, c: Point, ca: Color, cb: Color, cc: Color) {
    vertex(&mut vertices, a, ca)
    vertex(&mut vertices, b, cb)
    vertex(&mut vertices, c, cc)
}

// x/y is the lower-left corner; width/height are clip-coordinate extents.
pub fn quad(vertices: &mut []f32, x: f32, y: f32, width: f32, height: f32, color: Color) {
    a := Point { x: x, y: y }
    b := Point { x: x + width, y: y }
    c := Point { x: x + width, y: y + height }
    d := Point { x: x, y: y + height }
    triangle(&mut vertices, a, b, c, color)
    triangle(&mut vertices, a, c, d, color)
}

fn atlas_vertex(vertices: &mut []f32, point: Point, color: Color, u: f32, v: f32) {
    vertex(&mut vertices, point, color)
    vertices.push(u)
    vertices.push(v)
    vertices.push(0.0)
    vertices.push(0.0)
}

// Clip coordinates use +Y up. Atlas coordinates use the top-left origin.
pub fn atlas_quad(vertices: &mut []f32, x: f32, y: f32, width: f32, height: f32, uv: UVRect, color: Color) {
    a := Point {x:x, y:y}
    b := Point {x:x + width, y:y}
    c := Point {x:x + width, y:y + height}
    d := Point {x:x, y:y + height}
    atlas_vertex(&mut vertices, a, color, uv.left, uv.bottom)
    atlas_vertex(&mut vertices, b, color, uv.right, uv.bottom)
    atlas_vertex(&mut vertices, c, color, uv.right, uv.top)
    atlas_vertex(&mut vertices, a, color, uv.left, uv.bottom)
    atlas_vertex(&mut vertices, c, color, uv.right, uv.top)
    atlas_vertex(&mut vertices, d, color, uv.left, uv.top)
}

@test fn geometry_emits_interleaved_triangle_lists() {
    mut vertices: []f32 = []
    a := Point { x: -0.5, y: -0.5 }
    b := Point { x: 0.5, y: -0.5 }
    c := Point { x: 0.0, y: 0.5 }
    gradient_triangle(&mut vertices, a, b, c, rgb(1.0, 0.0, 0.0), rgb(0.0, 1.0, 0.0), rgba(0.0, 0.0, 1.0, 0.5))
    vertices.len == 24
    vertices[0] == -0.5
    vertices[2] == 0.0
    vertices[3] == 1.0
    vertices[4] == 1.0
    vertices[8] == 0.5
    vertices[13] == 1.0
    vertices[17] == 0.5
    vertices[22] == 1.0
    vertices[23] == 0.5
    vertices.clear()
    quad(&mut vertices, -1.0, -1.0, 2.0, 2.0, rgb(0.2, 0.3, 0.4))
    vertices.len == 48
    vertices[0] == -1.0
    vertices[9] == -1.0
    vertices[16] == 1.0
    vertices[17] == 1.0
    vertices[40] == -1.0
    vertices[41] == 1.0
}
