capability unsafe
import .objc as o
import std.bytes as bytes

@c_layout
pub struct State {
    application: ptr, rootPool: ptr, delegateClass: ptr, mode: ptr,
    createDevice: extern fn() -> ptr, now: extern fn() -> f64,
    window: ptr, view: ptr, layer: ptr, delegate: ptr,
    device: ptr, queue: ptr, pipeline: ptr, buffer: ptr,
    atlasPipeline: ptr, atlasTexture: ptr, atlasBuffer: ptr, atlasVertexCount: usize,
    generation: i64, active: i32, closed: i32, frames: i64, vertexCount: usize,
    width: i32, height: i32, pixelWidth: i32, pixelHeight: i32,
    scale: f64, logicalWidth: f64, logicalHeight: f64,
    start: f64, x: f64, y: f64, down: i32, key: i32, resized: i32,
    clear: o.Rect,
}

pub unsafe fn state() -> ptr {
    assert(size_of(State) <= 512)
    static_bytes("macos", 512)
}

unsafe fn shader_source() -> ptr {
    source := "#include <metal_stdlib>\nusing namespace metal;\n" +
        "struct Vertex { float4 position; float4 color; };\n" +
        "struct Output { float4 position [[position]]; float4 color; };\n" +
        "vertex Output vertex_main(uint i [[vertex_id]], constant Vertex* vertices [[buffer(0)]]) {\n" +
        "    return {vertices[i].position, vertices[i].color};\n}\n" +
        "fragment float4 fragment_main(Output v [[stage_in]]) { return v.color; }\n" +
        "struct AtlasVertex { float4 position; float4 color; float4 uv; };\n" +
        "struct AtlasOutput { float4 position [[position]]; float4 color; float2 uv; };\n" +
        "vertex AtlasOutput vertex_atlas(uint i [[vertex_id]], constant AtlasVertex* vertices [[buffer(0)]]) {\n" +
        "    return {vertices[i].position, vertices[i].color, vertices[i].uv.xy};\n}\n" +
        "fragment float4 fragment_atlas(AtlasOutput v [[stage_in]], texture2d<float> coverage [[texture(0)]]) {\n" +
        "    constexpr sampler texels(coord::normalized, address::clamp_to_edge, filter::nearest);\n" +
        "    return float4(v.color.rgb, v.color.a * coverage.sample(texels, v.uv).r);\n}"
    mut utf8: []u8 = []
    bytes.append_utf8(&mut utf8, source)
    utf8.push(0)
    o.named_string(addr(&utf8[0]))
}

unsafe fn pipeline(device: ptr, library: ptr, vertex_name: ptr, fragment_name: ptr) -> ptr {
    vertex := o.get_object(library, cstr("newFunctionWithName:"), o.named_string(vertex_name))
    fragment := o.get_object(library, cstr("newFunctionWithName:"), o.named_string(fragment_name))
    descriptor := o.new_object(cstr("MTLRenderPipelineDescriptor"))
    defer {
        o.release(descriptor)
        o.release(fragment)
        o.release(vertex)
    }
    if vertex == ptr(0) || fragment == ptr(0) || descriptor == ptr(0) { return ptr(0) }
    o.set_object(descriptor, cstr("setVertexFunction:"), vertex)
    o.set_object(descriptor, cstr("setFragmentFunction:"), fragment)
    attachment := o.get_index(o.get(descriptor, cstr("colorAttachments")), cstr("objectAtIndexedSubscript:"), 0)
    o.set_word(attachment, cstr("setPixelFormat:"), 80)
    o.set_flag(attachment, cstr("setBlendingEnabled:"), 1)
    o.set_word(attachment, cstr("setSourceRGBBlendFactor:"), 4)
    o.set_word(attachment, cstr("setDestinationRGBBlendFactor:"), 5)
    o.set_word(attachment, cstr("setSourceAlphaBlendFactor:"), 1)
    o.set_word(attachment, cstr("setDestinationAlphaBlendFactor:"), 5)
    mut error := ptr(0)
    o.two_objects(device, cstr("newRenderPipelineStateWithDescriptor:error:"), descriptor, addr(&mut error))
}

pub unsafe fn setup(s: &mut State) -> bool {
    s.device = s.createDevice()
    if s.device == ptr(0) { return false }
    s.queue = o.get(s.device, cstr("newCommandQueue"))
    if s.queue == ptr(0) { return false }
    mut error := ptr(0)
    library := o.three_objects(s.device, cstr("newLibraryWithSource:options:error:"), shader_source(), ptr(0), addr(&mut error))
    if library == ptr(0) { return false }
    defer { o.release(library) }
    s.pipeline = pipeline(s.device, library, cstr("vertex_main"), cstr("fragment_main"))
    s.atlasPipeline = pipeline(s.device, library, cstr("vertex_atlas"), cstr("fragment_atlas"))
    s.pipeline != ptr(0) && s.atlasPipeline != ptr(0)
}

pub unsafe fn release(s: &mut State) {
    o.release(s.atlasBuffer); s.atlasBuffer = ptr(0)
    o.release(s.atlasTexture); s.atlasTexture = ptr(0)
    o.release(s.atlasPipeline); s.atlasPipeline = ptr(0)
    o.release(s.buffer); s.buffer = ptr(0)
    o.release(s.pipeline); s.pipeline = ptr(0)
    o.release(s.queue); s.queue = ptr(0)
    o.release(s.device); s.device = ptr(0)
    s.vertexCount = 0
    s.atlasVertexCount = 0
}

pub unsafe fn render_target(s: &State, target: ptr, drawable: ptr) -> bool {
    if target == ptr(0) { return false }
    pass := o.get(o.class_named(cstr("MTLRenderPassDescriptor")), cstr("renderPassDescriptor"))
    attachment := o.get_index(o.get(pass, cstr("colorAttachments")), cstr("objectAtIndexedSubscript:"), 0)
    o.set_object(attachment, cstr("setTexture:"), target)
    o.set_word(attachment, cstr("setLoadAction:"), 2)
    o.set_word(attachment, cstr("setStoreAction:"), 1)
    o.set_rect(attachment, cstr("setClearColor:"), s.clear)
    command := o.get(s.queue, cstr("commandBuffer"))
    encoder := o.get_object(command, cstr("renderCommandEncoderWithDescriptor:"), pass)
    if encoder == ptr(0) { return false }
    o.set_word(encoder, cstr("setCullMode:"), 0)
    if s.vertexCount != 0 {
        o.set_object(encoder, cstr("setRenderPipelineState:"), s.pipeline)
        o.bind_buffer(encoder, cstr("setVertexBuffer:offset:atIndex:"), s.buffer, 0, 0)
        o.draw(encoder, cstr("drawPrimitives:vertexStart:vertexCount:"), 3, 0, s.vertexCount)
    }
    if s.atlasVertexCount != 0 {
        o.set_object(encoder, cstr("setRenderPipelineState:"), s.atlasPipeline)
        o.bind_buffer(encoder, cstr("setVertexBuffer:offset:atIndex:"), s.atlasBuffer, 0, 0)
        o.bind_fragment_texture(encoder, s.atlasTexture, 0)
        o.draw(encoder, cstr("drawPrimitives:vertexStart:vertexCount:"), 3, 0, s.atlasVertexCount)
    }
    o.action(encoder, cstr("endEncoding"))
    if drawable != ptr(0) { o.set_object(command, cstr("presentDrawable:"), drawable) }
    o.action(command, cstr("commit"))
    o.action(command, cstr("waitUntilCompleted"))
    o.get_word(command, cstr("status")) == 4 && o.get(command, cstr("error")) == ptr(0)
}

pub unsafe fn render(s: &mut State) -> bool {
    if s.active == 0 || s.closed != 0 || s.pixelWidth == 0 || s.pixelHeight == 0 { return true }
    if o.get_flag(s.window, cstr("isVisible")) == 0 || o.get_flag(s.window, cstr("isMiniaturized")) != 0 { return true }
    pool := o.pool()
    defer { o.drain(pool) }
    drawable := o.get(s.layer, cstr("nextDrawable"))
    if drawable == ptr(0) { return true }
    if !render_target(&s, o.get(drawable, cstr("texture")), drawable) { return false }
    s.frames += 1
    true
}

unsafe fn vertex_buffer(device: ptr, vertices: &[]f32) -> ptr {
    if vertices.len == 0 { return ptr(0) }
    o.buffer(device, cstr("newBufferWithBytes:length:options:"), addr(&vertices[0]), usize(vertices.len) * 4, 0)
}

pub unsafe fn upload(s: &mut State, data: &[]f32, atlas_data: &[]f32, red: f64, green: f64, blue: f64) -> bool {
    next := vertex_buffer(s.device, &data)
    if data.len != 0 && next == ptr(0) { return false }
    next_atlas := vertex_buffer(s.device, &atlas_data)
    if atlas_data.len != 0 && next_atlas == ptr(0) { o.release(next); return false }
    o.release(s.buffer)
    o.release(s.atlasBuffer)
    s.buffer = next
    s.atlasBuffer = next_atlas
    s.vertexCount = usize(data.len / 8)
    s.atlasVertexCount = usize(atlas_data.len / 12)
    s.clear = o.Rect {x: red, y: green, w: blue, h: 1.0}
    true
}
