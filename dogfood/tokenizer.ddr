import text.scan as text
import std.bytes

fn punctuation(r: rune) -> bool {
    r == `(` || r == `)` || r == `{` || r == `}` || r == `,` || r == `=` || r == `+`
}

// Advance past one token and borrow its original UTF-8 spelling.
fn next_token(source: &string, index: &mut i32) -> &[]u8 from source {
    while index < source.len {
        r := text.rune_at(source, index)
        width := text.width_at(source, index)
        if text.is_space(r) { index = index + width; continue }
        start := index
        index = index + width
        if r == `"` {
            mut closed := false
            while index < source.len {
                next := text.rune_at(source, index)
                index = index + text.width_at(source, index)
                if next == `\\` {
                    assert(index < source.len)
                    index = index + text.width_at(source, index)
                    continue
                }
                if next == `"` { closed = true; break }
            }
            assert(closed)
        } else if !punctuation(r) {
            while index < source.len {
                next := text.rune_at(source, index)
                if text.is_space(next) || punctuation(next) || next == `"` { break }
                index = index + text.width_at(source, index)
            }
        }
        return &source[start..index]
    }
    &source[index..index]
}

@test fn token_spelling_survives_the_next_scan() {
    source := " å=\"🌍\" "
    mut index := 0
    word := next_token(&source, &mut index)
    equals := next_token(&source, &mut index)
    quoted := next_token(&source, &mut index)
    trailing := next_token(&source, &mut index)
    assert(index == source.len && trailing.len == 0)
    assert(bytes.equals_text(&word, 0, word.len, "å"))
    assert(bytes.equals_text(&equals, 0, equals.len, "="))
    assert(bytes.equals_text(&quoted, 0, quoted.len, "\"🌍\""))
}

@test {
    ("") -> ""
    (" \t\u{A0}") -> ""
    ("fn hälsa(namn) { print(\"Hej 🌍\") }") -> "fn|hälsa|(|namn|)|{|print|(|\"Hej 🌍\"|)|}"
    ("å\u{A0}ä\u{2003}ö  ") -> "å|ä|ö"
    ("x = \"a\\\"b\" + y") -> "x|=|\"a\\\"b\"|+|y"
    ("日本語 + κόσμος") -> "日本語|+|κόσμος"
}
pub fn tokenize(source: string) -> string {
    mut output: []u8 = []
    mut index := 0
    while index < source.len {
        token := next_token(&source, &mut index)
        if token.len == 0 { break }
        if output.len > 0 { output.push(b'|') }
        bytes.extend(&mut output, &token)
    }
    decoded := bytes.decode(&output)
    assert(decoded.ok)
    decoded.value
}

fn main() {
    print(tokenize("fn hälsa(namn) { print(\"Hej 🌍\") }"))
}
